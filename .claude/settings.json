{
  "permissions": {
    "deny": ["Read(./.env)", "Edit(./lake/editions/**)", "Edit(./lake/scorecards/**)", "Edit(./lake/gaps/**)", "Edit(./frozen/**)", "Bash(rm -rf *)", "Bash(git push --force*)"]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Read|Edit|Write|Bash|Grep|Glob", "hooks": [{"type": "command", "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/guard.py"}]}
    ]
  }
}
